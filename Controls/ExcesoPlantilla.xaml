<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ComunioAdminTools.Models"
             xmlns:controls="clr-namespace:ComunioAdminTools.Controls"
             x:Name="Root"
             x:Class="ComunioAdminTools.Controls.ExcesoPlantilla">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="8" BackgroundColor="#E8EFEA">
            <Label Text="Usuari" FontAttributes="Bold" TextColor="#26332B" HorizontalTextAlignment="Center" />
            <Label Grid.Column="1" Text="Nombre de jugadors" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#26332B" />
        </Grid>
        <CollectionView Grid.Row="1" SelectionMode="None"
                        ItemsSource="{Binding ItemsSource, Source={x:Reference Root}, x:DataType=controls:ExcesoPlantilla}">
            <CollectionView.EmptyView>
                <Label Text="Cap equip supera el límit de jugadors" Padding="8,20" TextColor="#66736B" HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExcesoPlantillaModel">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="8,12">
                        <Label Text="{Binding UserName}" TextColor="#26332B" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="{Binding PlayerCount}" TextColor="#0B4D2C" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
