<button type="button" class="button-component @Class" style="background-color: @Color;"
        disabled="@Disabled" aria-label="@AriaLabel" title="@AriaLabel" @onclick="OnClick">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <i class="@Icon" aria-hidden="true"></i>
    }
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <span>@Text</span>
    }
</button>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string Color { get; set; } = AppColors.ComunioGreen;
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
