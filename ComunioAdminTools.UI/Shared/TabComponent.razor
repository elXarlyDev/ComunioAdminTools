<section class="tab-component" aria-label="@Label" inert="@Disabled">
    <div class="tabs" aria-label="@TabsLabel">
        @for (var index = 0; index < Tabs.Count; index++)
        {
            var tabIndex = index;
            <button type="button" class="@(selectedIndex == tabIndex ? "selected" : null)"
                    disabled="@Disabled"
                    aria-pressed="@(selectedIndex == tabIndex ? "true" : "false")"
                    @onclick="() => selectedIndex = tabIndex">@Tabs[tabIndex].Title</button>
        }
    </div>

    @for (var index = 0; index < Tabs.Count; index++)
    {
        <div class="tab-panel" hidden="@(selectedIndex != index)">
            @Tabs[index].Content
        </div>
    }
</section>

@code {
    private int selectedIndex;

    [Parameter, EditorRequired] public IReadOnlyList<TabItem> Tabs { get; set; } = [];
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? TabsLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }

    protected override void OnParametersSet()
    {
        if (selectedIndex >= Tabs.Count)
            selectedIndex = 0;
    }
}
