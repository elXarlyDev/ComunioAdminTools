@inherits LocalizedComponentBase

@if (Message is not null)
{
    <p role="status">@Message</p>
}
@if (Rows.Count > 0)
{
    <table>
        <thead><tr><th scope="col">@Text[TextKey.Username]</th><th scope="col">@ValueHeading</th></tr></thead>
        <tbody>
            @for (var index = 0; index < Rows.Count; index++)
            {
                var row = Rows[index];
                <tr class="@RowClass?.Invoke(index)"><td>@row.Name</td><td>@row.Value</td></tr>
            }
        </tbody>
    </table>
}
else if (Message is null)
{
    <p>@Text[TextKey.NoResults]</p>
}

@code {
    [Parameter] public IReadOnlyList<(string Name, string Value)> Rows { get; set; } = [];
    [Parameter] public string ValueHeading { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public Func<int, string?>? RowClass { get; set; }
}
