@using ComunioAdminTools.Core.Authentication
@using ComunioAdminTools.Core.Models
@using ComunioAdminTools.Core.Services
@inject AuthService Auth
@inject CashService Cash
@inject PointsService Points
@inject SquadService Squads

<MainPage @bind-Username="username" @bind-Password="password" HasSession="hasSession"
          IsLoading="busy" OnLogin="LoginAsync" OnLogout="LogoutAsync"
          OnSetPointsCash="PayRoundPointsAsync" OnRevertPointsCash="RevertRoundPointsAsync"
          OnAddFiveMillionCash="PayInternationalBreakAsync" OnShowTeamsLastPoints="ShowPointsAsync"
          OnCheckSquadExcess="ShowSquadExcessAsync" ResultsTitle="@resultTitle"
          ResultsContent="@(resultsOpen ? ResultContent : null)" OnCloseResults="CloseResults" />

@code {
    private string username = "";
    private string password = "";
    private bool hasSession;
    private bool busy;
    private bool resultsOpen;
    private string resultTitle = "";
    private string? message;
    private string valueHeading = "";
    private IReadOnlyList<(string Name, string Value)> rows = [];

    private RenderFragment ResultContent => @<ActionResults Rows="rows" ValueHeading="@valueHeading" Message="@message" />;

    protected override async Task OnInitializedAsync()
    {
        try { hasSession = await Auth.HasSessionAsync(); }
        catch { ShowMessage("Error", "No se ha podido recuperar la sesión guardada."); }
    }

    private async Task EnsureSessionAsync()
    {
        if (!await Auth.HasSessionAsync())
        {
            try { await Auth.LoginAsync(username, password); }
            finally { password = ""; }
        }
        hasSession = true;
    }

    private Task LoginAsync() => RunAsync(async () =>
    {
        try { await Auth.LoginAsync(username, password); hasSession = true; }
        finally { password = ""; }
    }, requiresSession: false);

    private Task LogoutAsync() => RunAsync(async () =>
    {
        await Auth.LogoutAsync();
        hasSession = false;
        password = "";
    }, requiresSession: false);

    private Task PayRoundPointsAsync() => RunAsync(async () =>
        ShowCash("Diners abonats", await Cash.PayRoundPointsAsync()));

    private Task RevertRoundPointsAsync() => RunAsync(async () =>
        ShowCash("Diners retirats", await Cash.RevertRoundPointsAsync()));

    private Task PayInternationalBreakAsync() => RunAsync(async () =>
        ShowCash("Abonament completat", await Cash.PayInternationalBreakAsync(),
            "S'han abonat 5M a cada usuari debut al paró de seleccions"));

    private Task ShowPointsAsync() => RunAsync(async () =>
    {
        var result = await Points.GetLastRoundPointsAsync();
        ShowRows("Punts de la última jornada", "Punts", result.Select(x => (x.UserName, x.Points.ToString())).ToArray());
    });

    private Task ShowSquadExcessAsync() => RunAsync(async () =>
    {
        var result = await Squads.GetSquadExcessAsync();
        ShowRows("Excés de plantilla", "Jugadors", result.Select(x => (x.UserName, x.PlayerCount.ToString())).ToArray());
    });

    private async Task RunAsync(Func<Task> action, bool requiresSession = true)
    {
        if (busy || resultsOpen) return;
        busy = true;
        try
        {
            if (requiresSession) await EnsureSessionAsync();
            await action();
        }
        catch (CashOperationException ex) { ShowCash("Operació incompleta", ex.ConfirmedPayments, ex.Message); }
        catch (AuthenticationRequiredException ex) { ShowMessage("Error", ex.Message); }
        catch (UnauthorizedAccessException ex) { ShowMessage("Error", ex.Message); }
        catch (ArgumentException) { ShowMessage("Error", "Introduce usuario y contraseña para iniciar sesión."); }
        catch { ShowMessage("Error", "No se ha podido completar la operación. Comprueba la conexión y la sesión."); }
        finally
        {
            busy = false;
            try { hasSession = await Auth.HasSessionAsync(); }
            catch { hasSession = false; }
        }
    }

    private void ShowCash(string title, IReadOnlyList<DineroJornadaModel> result, string? text = null) =>
        ShowRows(title, "Import", result.Select(x => (x.UserName, x.FormattedAmount)).ToArray(), text);

    private void ShowRows(string title, string heading, IReadOnlyList<(string Name, string Value)> result, string? text = null)
    {
        resultTitle = title;
        valueHeading = heading;
        rows = result;
        message = text;
        resultsOpen = true;
    }

    private void ShowMessage(string title, string text) => ShowRows(title, "", [], text);

    private void CloseResults()
    {
        resultsOpen = false;
        rows = [];
        message = null;
    }
}
