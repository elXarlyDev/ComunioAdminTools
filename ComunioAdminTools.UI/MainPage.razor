@page "/main"
@using Microsoft.JSInterop
@using ComunioAdminTools.Core.Authentication
@using ComunioAdminTools.Core.Models
@using ComunioAdminTools.Core.Services
@inherits LocalizedComponentBase
@inject NavigationManager Navigation
@inject AuthService Auth
@inject ISessionManager Session
@inject ICashService Cash
@inject IPointsService Points
@inject ISquadService Squads
@inject IMarketService Market
@inject IJSRuntime JS
@implements IAsyncDisposable

<main class="admin-page" aria-busy="@(busy ? "true" : "false")">
    <header class="session-header" inert="@(busy)">
        <div class="session-identity">
            <p class="session-user" title="@sessionUsername">@sessionUsername</p>
            <p class="session-community" title="@CommunityName">@CommunityName</p>
        </div>
        <ButtonComponent Icon="fa-solid fa-right-from-bracket" AriaLabel="@Text[TextKey.SignOut]"
                         Color="transparent" Class="sign-out" Disabled="@busy" OnClick="Logout" />
    </header>
    <div class="main-content" inert="@(busy)">
        <TabComponent Tabs="Tabs" Disabled="@(busy)"
                      Label="@Text[TextKey.AdminTools]" TabsLabel="@Text[TextKey.Sections]" />
    </div>

    @if (busy)
    {
        <div class="overlay">
            <div class="loading-card" role="status" aria-live="polite">
                <span class="spinner" aria-hidden="true"></span>
                <span>@Text[TextKey.Loading]</span>
            </div>
        </div>
    }

</main>

@code {
    private const int TransferPageSize = 10;

    private static readonly LineupFormation[] Formations =
    [
        LineupFormation.FourFourTwo, LineupFormation.ThreeFourThree, LineupFormation.ThreeFiveTwo,
        LineupFormation.FourThreeThree, LineupFormation.FourFiveOne
    ];

    private string sessionUsername = "";
    private bool hasSession;
    private bool busy = true;
    private bool queryResultsVisible;
    private MoneyResult? moneyResult;
    private CashPlan? pendingCashPlan;
    private TextKey titleKey = TextKey.Results;
    private SquadExcessResult? squadResult;
    private Exception? squadError;
    private IReadOnlyList<PlayerDetailsModel>? squadStatus;
    private PlayerDetailsModel?[] lineup = new PlayerDetailsModel?[11];
    private LineupFormation lineupFormation = LineupFormation.FourFourTwo;
    private Exception? squadStatusError;
    private TextKey? lineupSaveMessage;
    private Exception? lineupSaveError;
    private TextKey headingKey = TextKey.Amount;
    private TextKey? messageKey;
    private Exception? error;
    private IReadOnlyList<(string Name, int Value)> values = [];
    private bool classificationSelectorsVisible;
    private ClassificationPeriod classificationPeriod = ClassificationPeriod.Month;
    private IReadOnlyList<DateOnly> classificationMonths = [];
    private int selectedMonthIndex;
    private IReadOnlyList<TransferModel>? transfers;
    private Exception? marketError;
    private string playerFilter = "";
    private string buyerFilter = "";
    private string sellerFilter = "";
    private IReadOnlyList<string> marketUsers = [];
    private IReadOnlyList<TransferModel> filteredTransfers = [];
    private int transferPage;
    private ElementReference lineupElement;
    private ElementReference? boundLineupElement;
    private IJSObjectReference? lineupModule;
    private DotNetObjectReference<MainPage>? lineupReference;

    private int TransferPageCount => Math.Max(1, (filteredTransfers.Count + TransferPageSize - 1) / TransferPageSize);

    private string CommunityName => Session.Session?.Community?.Name ?? "";

    private IReadOnlyList<PlayerDetailsModel> Substitutes => squadStatus?
        .Where(player => !lineup.Any(starter => starter?.Id == player.Id)).ToArray() ?? [];

    private string SquadTitle => !string.IsNullOrWhiteSpace(squadResult?.MatchdayKey)
        ? Text.Format(TextKey.SquadExcessMatchday, squadResult.MatchdayKey)
        : Text[TextKey.SquadExcess];

    private IReadOnlyList<(string Name, string Value)> SquadRows => squadResult?.Squads.Select(row =>
        (row.UserName, row.PlayerCount.ToString("N0", Text.Culture))).ToArray() ?? [];

    private string? Message => error is not null ? Text.ErrorMessage(error)
        : messageKey is { } key ? Text[key] : null;

    private IReadOnlyList<(string Name, string Value)> Rows => values.Select(row =>
        (row.Name, row.Value.ToString("N0", Text.Culture))).ToArray();

    private IReadOnlyList<(string Name, string Value)> MoneyRows => moneyResult?.Values.Select(row =>
        (row.UserName, row.Amount.ToString("C0", Text.Culture))).ToArray() ?? [];

    private string? MoneyMessage => moneyResult?.Error is { } exception ? Text.ErrorMessage(exception)
        : moneyResult?.Message is { } key ? Text[key] : null;

    private bool CanRevertRound => moneyResult is { Title: TextKey.PaidMoney }
        && moneyResult.Values.Any(row => row.Amount > 0);

    private IReadOnlyList<TabItem> Tabs
    {
        get
        {
            var tabs = new List<TabItem>();

            if (Session.Session?.User is { IsAdmin: true } or { IsLeader: true })
                tabs.Add(new(Text[TextKey.Money], MoneyActions));

            tabs.Add(new(Text[TextKey.Queries], QueryActions));
            tabs.Add(new(Text[TextKey.Squad], SquadActions));
            tabs.Add(new(Text[TextKey.Market], MarketContent));
            return tabs;
        }
    }

    private RenderFragment MoneyActions => @<div class="action-panel money-panel">
        <div class="money-buttons">
            <button type="button" class="action-button points" disabled="@(busy)" @onclick="PayRoundPoints">
                <i class="fa-solid fa-euro-sign" aria-hidden="true"></i>
                @Text[TextKey.PayPoints]
            </button>
            <button type="button" class="action-button bonus" disabled="@(busy)" @onclick="PayInternationalBreak">
                <i class="fa-solid fa-earth-europe" aria-hidden="true"></i>
                @Text[TextKey.PayBreak]
            </button>
            <button type="button" class="action-button correction" disabled="@(busy)" @onclick="CorrectRoundPoints">
                <i class="fa-solid fa-euro-sign" aria-hidden="true"></i>
                @Text[TextKey.Correction]
            </button>
        </div>
        @if (moneyResult is { } result)
        {
            <section class="money-results" aria-labelledby="money-result-title" aria-live="polite">
                <h2 id="money-result-title">@Text[result.Title]</h2>
                <ActionResults Rows="MoneyRows" ValueHeading="@Text[TextKey.Amount]" Message="@MoneyMessage" />
                <div class="money-result-actions">
                    @if (CanRevertRound)
                    {
                        <button type="button" class="action-button revert" disabled="@(busy)" @onclick="RevertRoundPoints">
                            <i class="fa-solid fa-euro-sign" aria-hidden="true"></i>
                            @Text[TextKey.RevertPoints]
                        </button>
                    }
                    <button type="button" class="action-button query" disabled="@(busy)" @onclick="HideMoneyResults">
                        @Text[TextKey.Hide]
                    </button>
                </div>
            </section>
        }
        @if (pendingCashPlan is { } plan)
        {
            <CashConfirmation Plan="plan" Accepted="ConfirmCashPlan" Cancelled="CancelCashPlan" />
        }
    </div>;

    private RenderFragment QueryActions => @<div class="action-panel query-panel">
        <div class="query-buttons">
            <button type="button" class="action-button bonus" disabled="@busy" @onclick="ShowPoints">
                @Text[TextKey.QueryPoints]
            </button>
            <button type="button" class="action-button points" disabled="@busy" @onclick="ShowClassifications">
                @Text[TextKey.Standings]
            </button>
        </div>
        @if (classificationSelectorsVisible)
        {
            <div class="classification-filters">
                <label>
                    <span>@Text[TextKey.StandingsPeriod]</span>
                    <select disabled="@busy" @bind="classificationPeriod" @bind:after="RefreshClassification">
                        <option value="@ClassificationPeriod.Month">@Text[TextKey.Month]</option>
                        <option value="@ClassificationPeriod.FirstHalf">@Text[TextKey.FirstHalf]</option>
                        <option value="@ClassificationPeriod.SecondHalf">@Text[TextKey.SecondHalf]</option>
                        <option value="@ClassificationPeriod.Season">@Text[TextKey.Season]</option>
                    </select>
                </label>
                @if (classificationPeriod == ClassificationPeriod.Month)
                {
                    <label>
                        <span>@Text[TextKey.Month]</span>
                        <select disabled="@busy" @bind="selectedMonthIndex" @bind:after="RefreshClassification">
                            @for (var index = 0; index < classificationMonths.Count; index++)
                            {
                                <option value="@index">@classificationMonths[index].ToString("MMMM yyyy", Text.Culture)</option>
                            }
                        </select>
                    </label>
                }
            </div>
        }
        @if (queryResultsVisible)
        {
            <section class="query-results" aria-labelledby="query-result-title" aria-live="polite">
                <h2 id="query-result-title">@Text[titleKey]</h2>
                <ActionResults Rows="Rows" ValueHeading="@Text[headingKey]" Message="@Message" />
                <div class="query-result-actions">
                    <button type="button" class="action-button query" disabled="@busy" @onclick="HideQueryResults">
                        @Text[TextKey.Hide]
                    </button>
                </div>
            </section>
        }
    </div>;

    private RenderFragment SquadActions => @<div class="action-panel squad-panel">
        <div class="squad-buttons">
            <button type="button" class="action-button revert" disabled="@busy" @onclick="ShowSquadExcess">
                @Text[TextKey.QuerySquads]
            </button>
            <button type="button" class="action-button comunio" disabled="@busy" @onclick="ShowSquadStatus">
                @Text[TextKey.SquadStatus]
            </button>
        </div>
        @if (squadResult is not null || squadError is not null)
        {
            <section class="squad-results" aria-labelledby="squad-result-title" aria-live="polite">
                <h2 id="squad-result-title">@SquadTitle</h2>
                <p class="squad-excess-note">@Text[TextKey.SquadExcessNote]</p>
                <ActionResults Rows="SquadRows" ValueHeading="@Text[TextKey.Players]"
                               Message="@(squadError is not null ? Text.ErrorMessage(squadError) : null)" RowClass="GetSquadRowClass" />
                <div class="squad-result-actions">
                    <button type="button" class="action-button query" disabled="@busy" @onclick="HideSquadResults">
                        @Text[TextKey.Hide]
                    </button>
                </div>
            </section>
        }
        @if (squadStatus is not null || squadStatusError is not null)
        {
            @SquadStatusResults
        }
    </div>;

    private RenderFragment SquadStatusResults => @<section class="squad-status-results" aria-labelledby="squad-status-title" aria-live="polite">
        <div class="squad-title">
            <h2 id="squad-status-title">@Text[TextKey.SquadStatus]</h2>
            <LineupHelp />
        </div>
        @if (squadStatusError is not null)
        {
            <p role="alert">@Text.ErrorMessage(squadStatusError)</p>
        }
        else if (squadStatus is not null)
        {
            <label class="formation-picker">
                <span>@Text[TextKey.Formation]</span>
                <select disabled="@busy" @bind="lineupFormation" @bind:after="ChangeFormation">
                    @foreach (var formation in Formations)
                    {
                        <option value="@formation">@string.Join("-", ((int)formation).ToString().ToCharArray())</option>
                    }
                </select>
            </label>
            <div class="squad-lineup" @ref="lineupElement">
                <section aria-labelledby="starters-title">
                    <h3 id="starters-title">@Text[TextKey.Starters]</h3>
                    <ol class="squad-status-grid starters-list">
                        @for (var index = 0; index < lineup.Length; index++)
                        {
                            var slotIndex = index;
                            var player = lineup[slotIndex];
                            <li class="transfer-row lineup-player @(player is null ? $"empty-{lineupFormation.GetSlotPosition(slotIndex).ToString().ToLowerInvariant()}" : null)" data-position="@(11 - slotIndex)"
                                data-lineup-slot="@slotIndex" data-lineup-position="@lineupFormation.GetSlotPosition(slotIndex)"
                                data-lineup-player="@player?.Id" data-player-position="@player?.Position" tabindex="0" @key="slotIndex">
                                @if (player is not null)
                                {
                                    <SquadPlayerCard Player="player" />
                                }
                                else
                                {
                                    <span class="empty-slot" role="img" title="@GetSlotLabel(slotIndex)"
                                          aria-label="@($"{Text.Format(TextKey.EmptyLineupSlot, 11 - slotIndex)}: {GetSlotLabel(slotIndex)}")">
                                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                    </span>
                                }
                            </li>
                        }
                    </ol>
                </section>
                <section aria-labelledby="substitutes-title" data-lineup-bench tabindex="0">
                    <h3 id="substitutes-title">@Text[TextKey.Substitutes]</h3>
                    <ul class="squad-status-grid substitutes-list">
                        @foreach (var player in Substitutes)
                        {
                            <li class="transfer-row lineup-player" data-lineup-player="@player.Id"
                                data-lineup-substitute="@player.Id" data-player-position="@player.Position" tabindex="0" @key="player.Id">
                                <SquadPlayerCard Player="player" />
                            </li>
                        }
                    </ul>
                    @if (Substitutes.Count == 0)
                    {
                        <p>@Text[TextKey.NoResults]</p>
                    }
                </section>
            </div>
        }
        else
        {
            <p>@Text[TextKey.NoResults]</p>
        }
        @if (lineupSaveError is not null)
        {
            <p role="alert">@(lineupSaveMessage is { } errorKey ? Text[errorKey] : Text.ErrorMessage(lineupSaveError))</p>
        }
        else if (lineupSaveMessage == TextKey.LineupSaved)
        {
            <LineupSaveConfirmation Closed="ClearLineupSaveFeedback" />
        }
        <div class="squad-result-actions">
            @if (squadStatus is not null && squadStatusError is null)
            {
                <button type="button" class="action-button comunio save-lineup" disabled="@busy" @onclick="SaveLineup">
                    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                    @Text[TextKey.Save]
                </button>
            }
            <button type="button" class="action-button query" disabled="@busy" @onclick="HideSquadStatus">
                @Text[TextKey.Hide]
            </button>
        </div>
    </section>;

    private RenderFragment MarketContent => @<div class="action-panel market-panel">
        <button type="button" class="action-button market" disabled="@busy" @onclick="ShowTransferHistory">
            @Text[TextKey.TransferHistory]
        </button>
        @if (marketError is not null)
        {
            <p role="alert">@Text.ErrorMessage(marketError)</p>
        }
        else if (transfers is not null)
        {
            <div class="market-filters">
                <h2>@Text[TextKey.Filters]</h2>
                <label>
                    <span>@Text[TextKey.FilterPlayer]</span>
                    <input type="search" disabled="@busy" @bind="playerFilter" @bind:event="oninput" @bind:after="FilterTransfers" />
                </label>
                <label>
                    <span>@Text[TextKey.FilterBuyer]</span>
                    <select disabled="@busy" @bind="buyerFilter" @bind:after="FilterTransfers">
                        <option value="">@Text[TextKey.AllUsers]</option>
                        @foreach (var user in marketUsers)
                        {
                            <option value="@user">@user</option>
                        }
                    </select>
                </label>
                <label>
                    <span>@Text[TextKey.FilterSeller]</span>
                    <select disabled="@busy" @bind="sellerFilter" @bind:after="FilterTransfers">
                        <option value="">@Text[TextKey.AllUsers]</option>
                        @foreach (var user in marketUsers)
                        {
                            <option value="@user">@user</option>
                        }
                    </select>
                </label>
            </div>
            <section class="market-results" aria-label="@Text[TextKey.TransferHistory]" aria-live="polite">
                <h2>@Text[TextKey.Transfers]</h2>
                @if (filteredTransfers.Count == 0)
                {
                    <p>@Text[TextKey.NoResults]</p>
                }
                else
                {
                    <ul class="transfer-grid">
                        @foreach (var transfer in filteredTransfers.Skip(transferPage * TransferPageSize).Take(TransferPageSize))
                        {
                            <li class="transfer-row">
                                <div>
                                    <strong>@transfer.PlayerName</strong> <span class="transfer-club">(@transfer.ClubName)</span>
                                    <time datetime="@transfer.DateChanged.ToString("O")">@transfer.DateChanged.ToString("g", Text.Culture)</time>
                                </div>
                                <div>@Text[TextKey.TransferPrice]: <strong>@transfer.Price.ToString("C0", Text.Culture)</strong></div>
                                <div>@transfer.SellerName <span> -&gt; </span> @transfer.BuyerName</div>
                            </li>
                        }
                    </ul>
                    <nav class="market-pagination" aria-label="@Text[TextKey.TransferPages]">
                        <button type="button" class="action-button query" disabled="@(busy || transferPage == 0)" @onclick="() => ChangeTransferPage(-10)">
                            -10
                        </button>
                        <button type="button" class="action-button query" disabled="@(busy || transferPage == 0)" @onclick="() => ChangeTransferPage(-1)">
                            -1
                        </button>
                        <span>@Text.Format(TextKey.PageOf, transferPage + 1, TransferPageCount)</span>
                        <button type="button" class="action-button query" disabled="@(busy || transferPage + 1 >= TransferPageCount)" @onclick="() => ChangeTransferPage(1)">
                            +1
                        </button>
                        <button type="button" class="action-button query" disabled="@(busy || transferPage + 1 >= TransferPageCount)" @onclick="() => ChangeTransferPage(10)">
                            +10
                        </button>
                    </nav>
                }
            </section>
        }
    </div>;

    [JSInvokable]
    public Task MoveLineupPlayer(string playerId, int? targetSlot, string? substituteId) => InvokeAsync(() =>
    {
        if (busy || squadStatus is null)
        {
            return;
        }

        var sourceSlot = Array.FindIndex(lineup, player => player?.Id == playerId);
        var player = sourceSlot >= 0 ? lineup[sourceSlot] : Substitutes.FirstOrDefault(player => player.Id == playerId);

        if (player is null)
        {
            return;
        }

        if (targetSlot is int slot)
        {
            if (slot < 0 || slot >= lineup.Length || player.Position != lineupFormation.GetSlotPosition(slot)
                || (sourceSlot >= 0 && lineup[slot] is { } displaced && displaced.Position != lineupFormation.GetSlotPosition(sourceSlot)))
            {
                return;
            }

            if (sourceSlot == slot)
            {
                return;
            }

            if (sourceSlot >= 0)
                lineup[sourceSlot] = lineup[slot];

            lineup[slot] = player;
        }
        else if (sourceSlot >= 0)
        {
            var replacement = substituteId is not null ? Substitutes.FirstOrDefault(player => player.Id == substituteId) : null;

            if (substituteId is not null && (replacement is null || replacement.Position != lineupFormation.GetSlotPosition(sourceSlot)))
            {
                return;
            }

            lineup[sourceSlot] = replacement;
        }
        else
        {
            return;
        }

        ClearLineupSaveFeedback();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Session.SessionChanged -= OnSessionChanged;

        if (lineupModule is not null)
        {
            try
            {
                if (boundLineupElement is { } element)
                    await lineupModule.InvokeVoidAsync("detach", element);

                await lineupModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }

        lineupReference?.Dispose();
    }

    protected override void OnInitialized()
    {
        Session.SessionChanged += OnSessionChanged;

        try { UpdateSession(); }
        catch { ShowMessage(TextKey.RestoreSessionError); }
        finally { busy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (squadStatus is null || squadStatusError is not null)
        {
            if (lineupModule is not null && boundLineupElement is { } previous)
            {
                await lineupModule.InvokeVoidAsync("detach", previous);
                boundLineupElement = null;
            }

            return;
        }

        if (boundLineupElement?.Id == lineupElement.Id)
        {
            return;
        }

        lineupModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ComunioAdminTools.UI/lineupDrag.js");

        if (boundLineupElement is { } oldElement)
            await lineupModule.InvokeVoidAsync("detach", oldElement);

        lineupReference ??= DotNetObjectReference.Create(this);
        await lineupModule.InvokeVoidAsync("attach", lineupElement, lineupReference);
        boundLineupElement = lineupElement;
    }

    private void UpdateSession()
    {
        if (Session.Session is not { } profile)
        {
            hasSession = false;
            sessionUsername = "";
            Navigation.NavigateTo("", replace: true);
            return;
        }

        sessionUsername = !string.IsNullOrWhiteSpace(profile.User.Name) ? profile.User.Name
            : !string.IsNullOrWhiteSpace(profile.User.FirstName) ? profile.User.FirstName : "";

        hasSession = true;
    }

    private void EnsureSession()
    {
        UpdateSession();

        if (!hasSession)
        {
            throw new AuthenticationRequiredException(Text, TextKey.SignInRequired);
        }
    }

    private Task Logout() => Run(() => Auth.Logout(), requiresSession: false);

    private Task PayRoundPoints() => PrepareCashOperation(CashOperation.RoundPoints);

    private Task RevertRoundPoints() => PrepareCashOperation(CashOperation.RevertRoundPoints);

    private Task PayInternationalBreak() => PrepareCashOperation(CashOperation.InternationalBreak);

    private Task CorrectRoundPoints() => PrepareCashOperation(CashOperation.Correction);

    private Task PrepareCashOperation(CashOperation operation) => Run(async () =>
    {
        pendingCashPlan = null;
        pendingCashPlan = await Cash.Prepare(operation);
    }, moneyAction: true);

    private Task ConfirmCashPlan()
    {
        if (busy || pendingCashPlan is not { } plan)
        {
            return Task.CompletedTask;
        }

        pendingCashPlan = null;

        var title = plan.Operation switch
        {
            CashOperation.RoundPoints => TextKey.PaidMoney,
            CashOperation.RevertRoundPoints => TextKey.RevertedMoney,
            CashOperation.Correction => TextKey.CorrectionCompleted,
            _ => TextKey.PaymentCompleted
        };

        return RunMoney(() => Cash.Apply(plan), title,
            plan.Operation == CashOperation.InternationalBreak ? TextKey.BreakPaymentCompleted : null);
    }

    private void CancelCashPlan() => pendingCashPlan = null;

    private Task RunMoney(Func<Task<IReadOnlyList<CashResultModel>>> action, TextKey title, TextKey? message = null)
        => Run(async () =>
        {
            moneyResult = null;
            moneyResult = new(title, await action(), message);
        }, moneyAction: true);

    private Task ShowTransferHistory() => Run(async () =>
    {
        transfers = null;
        marketError = null;

        try
        {
            transfers = await Market.GetTransferHistory();
            var communityUsers = await Market.GetCommunityUserNames();

            marketUsers = communityUsers
                .Concat(transfers.SelectMany(transfer => new[] { transfer.BuyerName, transfer.SellerName }))
                .Append("Computer")
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name, StringComparer.Create(Text.Culture, ignoreCase: true))
                .ToArray();

            FilterTransfers();
        }
        catch (Exception ex)
        {
            marketError = ex;
        }
    });

    private void ChangeTransferPage(int offset)
    {
        transferPage = Math.Clamp(transferPage + offset, 0, TransferPageCount - 1);
    }

    private void FilterTransfers()
    {
        filteredTransfers = transfers?.Where(transfer =>
            transfer.PlayerName.Contains(playerFilter.Trim(), StringComparison.OrdinalIgnoreCase)
            && (buyerFilter.Length == 0 || string.Equals(transfer.BuyerName, buyerFilter, StringComparison.OrdinalIgnoreCase))
            && (sellerFilter.Length == 0 || string.Equals(transfer.SellerName, sellerFilter, StringComparison.OrdinalIgnoreCase))).ToArray() ?? [];

        transferPage = 0;
    }

    private Task ShowPoints() => Run(async () =>
    {
        classificationSelectorsVisible = false;
        var result = await Points.GetLastRoundPoints();
        ShowRows(TextKey.LastRoundPoints, TextKey.Points, result.Select(x => (x.UserName, x.Points)).ToArray());
    });

    private Task ShowSquadExcess() => Run(async () =>
    {
        HideSquadStatus();
        squadResult = null;
        squadError = null;

        try
        {
            squadResult = await Squads.GetSquadExcess();
        }
        catch (Exception ex)
        {
            squadError = ex;
        }
    });

    private Task ShowSquadStatus() => Run(async () =>
    {
        HideSquadResults();
        ClearLineupSaveFeedback();
        squadStatus = null;
        squadStatusError = null;
        lineup = new PlayerDetailsModel?[11];

        try
        {
            var players = await Squads.GetSquadStatus();
            var result = await Squads.GetLineup();
            lineup = result.Starters.ToArray();
            lineupFormation = result.Formation;
            ChangeFormation();
            squadStatus = players;
        }
        catch (Exception ex)
        {
            squadStatusError = ex;
        }
    });

    private void ChangeFormation()
    {
        ClearLineupSaveFeedback();

        for (var index = 0; index < lineup.Length; index++)
        {
            if (lineup[index]?.Position != lineupFormation.GetSlotPosition(index))
                lineup[index] = null;
        }
    }

    private string GetSlotLabel(int index) => Text[lineupFormation.GetSlotPosition(index) switch
    {
        PlayerPosition.Keeper => TextKey.Goalkeeper,
        PlayerPosition.Defender => TextKey.Defender,
        PlayerPosition.Midfielder => TextKey.Midfielder,
        _ => TextKey.Striker
    }];

    private Task SaveLineup() => Run(async () =>
    {
        if (squadStatus is null)
        {
            return;
        }

        ClearLineupSaveFeedback();
        var sent = false;

        try
        {
            await Squads.SaveLineup(lineupFormation, lineup);
            sent = true;
            var result = await Squads.GetLineup();
            lineup = result.Starters.ToArray();
            lineupFormation = result.Formation;
            ChangeFormation();
            lineupSaveMessage = TextKey.LineupSaved;
        }
        catch (Exception ex)
        {
            lineupSaveError = ex;
            lineupSaveMessage = sent ? TextKey.LineupReloadFailed : null;
        }
    });

    private void ClearLineupSaveFeedback()
    {
        lineupSaveMessage = null;
        lineupSaveError = null;
    }

    private Task ShowClassifications() => Run(async () =>
    {
        classificationMonths = SeasonCalendar.GetMonths(DateOnly.FromDateTime(DateTime.Now));
        selectedMonthIndex = classificationMonths.Count - 1;
        classificationPeriod = ClassificationPeriod.Month;
        classificationSelectorsVisible = true;
        await LoadClassification();
    });

    private Task RefreshClassification() => Run(LoadClassification);

    private async Task LoadClassification()
    {
        var month = classificationMonths[selectedMonthIndex];

        var result = await (classificationPeriod switch
        {
            ClassificationPeriod.Month => Points.GetMonthlyStandings(month.Year, month.Month),
            ClassificationPeriod.FirstHalf => Points.GetFirstHalfStandings(),
            ClassificationPeriod.SecondHalf => Points.GetSecondHalfStandings(),
            ClassificationPeriod.Season => Points.GetSeasonStandings(),
            _ => throw new InvalidOperationException()
        });

        ShowRows(TextKey.Standings, TextKey.Points, result.Teams
            .OrderByDescending(team => team.TotalPoints)
            .Select(team => (team.TeamInfo.User.Name, team.TotalPoints)).ToArray());
    }

    private async Task Run(Func<Task> action, bool requiresSession = true, bool moneyAction = false)
    {
        if (busy)
        {
            return;
        }

        busy = true;

        try
        {
            if (requiresSession) EnsureSession();
            await action();
        }
        catch (CashOperationException ex) when (moneyAction)
        {
            moneyResult = new(TextKey.IncompleteOperation, ex.ConfirmedPayments, Error: ex);
        }
        catch (Exception ex)
        {
            if (moneyAction)
                moneyResult = new(TextKey.Error, [], Error: ex);
            else
            {
                ShowRows(TextKey.Error, TextKey.Amount, []);
                error = ex;
            }
        }
        finally
        {
            try { UpdateSession(); }
            catch { hasSession = false; sessionUsername = ""; }

            busy = false;
        }
    }

    private void ShowRows(TextKey title, TextKey heading, IReadOnlyList<(string Name, int Value)> result, TextKey? message = null)
    {
        titleKey = title;
        headingKey = heading;
        values = result;
        messageKey = message;
        error = null;
        queryResultsVisible = true;
    }

    private string GetSquadRowClass(int index) => squadResult!.Squads[index].PlayerCount > 25
        ? "row-over-limit" : "row-within-limit";

    private void ShowMessage(TextKey message) => ShowRows(TextKey.Error, TextKey.Amount, [], message);

    private void HideMoneyResults() => moneyResult = null;

    private void HideQueryResults()
    {
        classificationSelectorsVisible = false;
        queryResultsVisible = false;
        values = [];
        messageKey = null;
        error = null;
    }

    private void HideSquadResults()
    {
        squadResult = null;
        squadError = null;
    }

    private void HideSquadStatus()
    {
        ClearLineupSaveFeedback();
        squadStatus = null;
        squadStatusError = null;
        lineup = new PlayerDetailsModel?[11];
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (busy || !hasSession)
        {
            return;
        }

        pendingCashPlan = null;

        try { UpdateSession(); }
        catch { hasSession = false; sessionUsername = ""; }

        StateHasChanged();
    });

    private enum ClassificationPeriod { Month, FirstHalf, SecondHalf, Season }

    private sealed record MoneyResult(
        TextKey Title,
        IReadOnlyList<CashResultModel> Values,
        TextKey? Message = null,
        Exception? Error = null);
}
