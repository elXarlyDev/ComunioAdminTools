<main class="admin-page" aria-busy="@(IsLoading ? "true" : "false")">
    <div class="main-content" inert="@(IsLoading || ResultsContent is not null)">
        <header class="brand">
            <h1>comunio</h1>
            <p>Admin Tools</p>
        </header>

        @if (!HasSession)
        {
        <label class="credential">
            <span>Usuari</span>
            <input type="text" placeholder="Introdueix l'usuari" autocomplete="username"
                   @bind:get="Username" @bind:set="SetUsernameAsync" />
        </label>

        <label class="credential">
            <span>Contrasenya</span>
            <input type="password" placeholder="Introdueix la contrasenya" autocomplete="current-password"
                   @bind:get="Password" @bind:set="SetPasswordAsync" />
        </label>

        <button type="button" class="action-button points" disabled="@(IsLoading || !OnLogin.HasDelegate)"
                @onclick="OnLogin">Iniciar sessió</button>
        }
        else
        {
            <p role="status">Sessió de Comunio iniciada.</p>
            <button type="button" class="action-button query" disabled="@(IsLoading || !OnLogout.HasDelegate)"
                    @onclick="OnLogout">Tancar sessió</button>
        }

        <section class="actions" aria-label="Eines d'administració">
            <div class="tabs" aria-label="Seccions">
                <button type="button" class="@(dinersSelected ? "selected" : null)"
                        aria-pressed="@(dinersSelected ? "true" : "false")"
                        @onclick="() => dinersSelected = true">Diners</button>
                <button type="button" class="@(!dinersSelected ? "selected" : null)"
                        aria-pressed="@(!dinersSelected ? "true" : "false")"
                        @onclick="() => dinersSelected = false">Consultes</button>
            </div>

            <div class="action-panel" hidden="@(!dinersSelected)">
                <button type="button" class="action-button points"
                        disabled="@(IsLoading || !OnSetPointsCash.HasDelegate)" @onclick="OnSetPointsCash">
                    Posar diners dels punts
                </button>
                <button type="button" class="action-button revert"
                        disabled="@(IsLoading || !OnRevertPointsCash.HasDelegate)" @onclick="OnRevertPointsCash">
                    Revertir diners dels punts
                </button>
                <button type="button" class="action-button bonus"
                        disabled="@(IsLoading || !OnAddFiveMillionCash.HasDelegate)" @onclick="OnAddFiveMillionCash">
                    Abonar paró de seleccions
                </button>
            </div>

            <div class="action-panel" hidden="@dinersSelected">
                <button type="button" class="action-button query"
                        disabled="@(IsLoading || !OnShowTeamsLastPoints.HasDelegate)" @onclick="OnShowTeamsLastPoints">
                    Consultar punts última jornada
                </button>
                <button type="button" class="action-button query"
                        disabled="@(IsLoading || !OnCheckSquadExcess.HasDelegate)" @onclick="OnCheckSquadExcess">
                    Comprovar excés de plantilla
                </button>
            </div>
        </section>
    </div>

    @if (IsLoading)
    {
        <div class="overlay">
            <div class="loading-card" role="status" aria-live="polite">
                <span class="spinner" aria-hidden="true"></span>
                <span>Cargando...</span>
            </div>
        </div>
    }

    @if (ResultsContent is not null)
    {
        <div class="overlay">
            <section class="results-card" role="dialog" aria-label="@ResultsTitle" aria-modal="true">
                <h2>@ResultsTitle</h2>
                <div class="results-body">@ResultsContent</div>
                <button type="button" class="action-button points" disabled="@(!OnCloseResults.HasDelegate)"
                        @onclick="OnCloseResults">Cerrar</button>
            </section>
        </div>
    }
</main>

@code {
    // Presentation only. AdminPage connects these callbacks to Core services.
    private bool dinersSelected = true;

    [Parameter] public string Username { get; set; } = "";
    [Parameter] public EventCallback<string> UsernameChanged { get; set; }
    [Parameter] public string Password { get; set; } = "";
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasSession { get; set; }
    [Parameter] public EventCallback OnLogin { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }
    [Parameter] public EventCallback OnSetPointsCash { get; set; }
    [Parameter] public EventCallback OnRevertPointsCash { get; set; }
    [Parameter] public EventCallback OnAddFiveMillionCash { get; set; }
    [Parameter] public EventCallback OnShowTeamsLastPoints { get; set; }
    [Parameter] public EventCallback OnCheckSquadExcess { get; set; }
    [Parameter] public string ResultsTitle { get; set; } = "Resultats";
    [Parameter] public RenderFragment? ResultsContent { get; set; }
    [Parameter] public EventCallback OnCloseResults { get; set; }

    private async Task SetUsernameAsync(string value)
    {
        Username = value;
        await UsernameChanged.InvokeAsync(value);
    }

    private async Task SetPasswordAsync(string value)
    {
        Password = value;
        await PasswordChanged.InvokeAsync(value);
    }
}
